# Copier ce fichier en .env puis adapter les valeurs :  cp .env.example .env
# Lu par docker compose (docker-compose.yml).

# Port exposé sur la machine → http://localhost:5175
FRONT_PORT=5175

# Adresse de l'API vue depuis le conteneur du front.
# Backend lancé avec Docker sur la même machine : host.docker.internal
# (reprendre le API_PORT du .env d'eFlotte-Api)
VITE_PROXY_TARGET=http://host.docker.internal:8050

# ── Production (docker-compose.prod.yml) ──────────────────────────────────────
# Adresse de l'API utilisée par le site construit.
# Vide = même adresse que le site (/api relayé par Caddy) : réglage conseillé.
VITE_API_URL=
